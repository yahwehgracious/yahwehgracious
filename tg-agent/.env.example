# Локально: cp .env.example .env. На GitHub ці значення — у Settings → Secrets → Actions.

# Meta Marketing API: ключ системного користувача targetolog (ads_read + ads_management)
META_ACCESS_TOKEN=
# Бот, що пише щоранковий звіт
TELEGRAM_BOT_TOKEN=
# ШІ для розбору конкурентів та ідей (вистачить одного з двох)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
